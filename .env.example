BOT_TOKEN=123456789:AAE_your_token_here

# /all только для админов группы
ADMIN_ONLY=false

# Сколько упоминаний в одном сообщении
MENTIONS_PER_MESSAGE=40

# /out без аргументов — секунд (3600 = час)
SNOOZE_SECONDS=3600

# аккаунт для полного состава — https://my.telegram.org
API_ID=
API_HASH=
PHONE=+79990000000

# автосинк всех известных групп, 0 = выключить
SYNC_EVERY_MINUTES=180

# для ручного python sync_members.py
SYNC_CHAT=
